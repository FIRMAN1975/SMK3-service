# ============================================================
# GENERAL
# ============================================================
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================================
# KEYCLOAK AUTHENTICATION
# ============================================================
KEYCLOAK_ISSUER=http://localhost:8080/realms/sekolah
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/sekolah/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=sekolah-api
KEYCLOAK_CLIENT_SECRET=your-secret-here

# ============================================================
# API GATEWAY CONFIGURATION
# ============================================================
GATEWAY_PORT=3000
INTERNAL_GATEWAY_SECRET=your-internal-gateway-secret-change-in-production

# Internal service URLs (for container-to-container communication in Docker)
SERVICE_PELANGGARAN_URL=http://service-pelanggaran:3001/api
SERVICE_PROFILE_URL=http://service-profile:3007/api
SERVICE_BERITA_URL=http://service-berita:3003/api
SERVICE_PORTOFOLIO_URL=http://service-portofolio:3008/api
SERVICE_MANAGEMENT_URL=http://service-management:3005

# ============================================================
# DATABASE - SHARED (used by multiple services)
# ============================================================
DATABASE_URL=postgresql://postgres:postgres_pass@localhost:5432/db_berita
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pass

# ============================================================
# DATABASE - SERVICE BERITA
# ============================================================
DB_BERITA_URL=postgresql://postgres:postgres_pass@localhost:5432/db_berita
DB_BERITA_HOST=localhost
DB_BERITA_PORT=5432
DB_BERITA_NAME=db_berita
DB_BERITA_USER=postgres
DB_BERITA_PASSWORD=postgres_pass

# ============================================================
# DATABASE - SERVICE PROFILE
# ============================================================
DB_PROFILE_URL=postgresql://postgres:postgres_pass@localhost:5434/db_profile
DB_PROFILE_HOST=localhost
DB_PROFILE_PORT=5434
DB_PROFILE_NAME=db_profile
DB_PROFILE_USER=postgres
DB_PROFILE_PASSWORD=postgres_pass

# ============================================================
# DATABASE - SERVICE PELANGGARAN
# ============================================================
DB_PELANGGARAN_URL=postgresql://postgres:postgres_pass@localhost:5433/db_pelanggaran
DB_PELANGGARAN_HOST=localhost
DB_PELANGGARAN_PORT=5433
DB_PELANGGARAN_NAME=db_pelanggaran
DB_PELANGGARAN_USER=postgres
DB_PELANGGARAN_PASSWORD=postgres_pass

# ============================================================
# DATABASE - SERVICE PORTOFOLIO
# ============================================================
DB_PORTOFOLIO_URL=postgresql://postgres:postgres_pass@localhost:5436/db_portofolio
DB_PORTOFOLIO_HOST=localhost
DB_PORTOFOLIO_PORT=5436
DB_PORTOFOLIO_NAME=db_portofolio
DB_PORTOFOLIO_USER=postgres
DB_PORTOFOLIO_PASSWORD=postgres_pass

# ============================================================
# DATABASE - SERVICE MANAGEMENT
# ============================================================
DB_MANAGEMENT_URL=postgresql://postgres:postgres_pass@localhost:5435/db_management
DB_MANAGEMENT_HOST=localhost
DB_MANAGEMENT_PORT=5435
DB_MANAGEMENT_NAME=db_management
DB_MANAGEMENT_USER=postgres
DB_MANAGEMENT_PASSWORD=postgres_pass

# ============================================================
# DATABASE PERFORMANCE
# ============================================================
DB_POOL_SIZE=10
DB_MAX_QUERY_TIME=30000
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=3000

# ============================================================
# SERVICE PORTS
# ============================================================
SERVICE_BERITA_PORT=3003
SERVICE_PROFILE_PORT=3007
SERVICE_PELANGGARAN_PORT=3001
SERVICE_PORTOFOLIO_PORT=3008
SERVICE_MANAGEMENT_PORT=3005

# ============================================================
# RABBITMQ
# ============================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ============================================================
# KEYCLOAK DATABASE
# ============================================================
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASS=keycloak_pass
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin123

# ============================================================
# TYPEORM CONFIGURATION (Development)
# ============================================================
# Force synchronize database schema (use only in development!)
# Set to 'true' to auto-migrate schema without running migrations
# WARNING: Do NOT use in production
TYPEORM_SYNC=false

# ============================================================
# FILE UPLOADS
# ============================================================
UPLOADS_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
